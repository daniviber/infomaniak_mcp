# ── Infomaniak API ────────────────────────────────────────────────────────────
# Token created at https://manager.infomaniak.com/v3/ng/accounts/token/list
# Give it only the scopes you need (e.g. drive, mail, domain, ...).
INFOMANIAK_API_TOKEN=

# Calendar of a mailbox: create this token while logged in AS THE MAILBOX USER,
# with scopes "workspace:calendar" and "user_info". Falls back to INFOMANIAK_API_TOKEN.
INFOMANIAK_CALENDAR_TOKEN=
# INFOMANIAK_DISABLE_CALENDAR=true

# ── Tool policy ───────────────────────────────────────────────────────────────
# Expose only read tools (list/get/search/download). Strongly recommended for
# exploratory use and for any assistant that reads untrusted content.
INFOMANIAK_READ_ONLY=false
# Expose the generic infomaniak_api_call tool (whole API surface of the token).
INFOMANIAK_ALLOW_RAW_API=false

# ── kDrive limits ─────────────────────────────────────────────────────────────
KDRIVE_MAX_DOWNLOAD_BYTES=10485760
KDRIVE_MAX_UPLOAD_BYTES=52428800

# ── kChat (optional) ──────────────────────────────────────────────────────────
# KCHAT_HOST=your-team.kchat.infomaniak.com
# KCHAT_TOKEN=

# ── Transport ─────────────────────────────────────────────────────────────────
# stdio (default, Claude Desktop / CLI) or http
MCP_TRANSPORT=stdio

# HTTP transport only ─────────────────────────────────────────────────────────
MCP_HOST=127.0.0.1
MCP_PORT=3000
# Shared secret; clients send "Authorization: Bearer <MCP_HTTP_AUTH_TOKEN>". Min 16 chars.
# Generate one with: openssl rand -hex 32
MCP_HTTP_AUTH_TOKEN=
# MCP_HTTP_ALLOW_UNAUTHENTICATED=true   # loopback only, NOT recommended
# MCP_ALLOWED_HOSTS=mcp.example.com     # Host header allow-list when not bound to loopback
# MCP_CORS_ORIGINS=https://app.example.com
# MCP_MAX_SESSIONS=100
# MCP_SESSION_TTL_MS=1800000
# MCP_STATELESS=false
