# Reference runner: Node 20.19.2 / npm 9.2.0. This file is documentation,
# not loaded automatically. Export variables or configure the MCP client's env.
# Required in normal operation; offline verification supplies its own sentinel.
INFOMANIAK_API_TOKEN=
# Optional: mailbox owner's token (workspace:calendar, user_info).
# Leave UNSET to reuse the main token; an empty value is invalid.
# INFOMANIAK_CALENDAR_TOKEN=
# Optional dedicated mail token for https://mail.infomaniak.com/api.
# Leave UNSET to reuse INFOMANIAK_API_TOKEN; an empty value is invalid.
# INFOMANIAK_MAIL_TOKEN=

# Policy: readOnly preserves visibility and denies write/destructive calls.
INFOMANIAK_READ_ONLY=false
# Experimental tools require this flag; raw API requires BOTH flags.
INFOMANIAK_ALLOW_EXPERIMENTAL=false
INFOMANIAK_ALLOW_RAW_API=false
# readOnly permits raw GET only. Flags govern visibility AND callability.

# Provider timeout (positive milliseconds) and tools/list cache TTL (>= 0).
INFOMANIAK_TIMEOUT_MS=30000
MCP_TOOLS_TTL_MS=60000

# Configurable transfer and HTTP bounds, in bytes (HTTP also accepts kb/mb/gb).
KDRIVE_MAX_DOWNLOAD_BYTES=10485760
KDRIVE_MAX_UPLOAD_BYTES=52428800
MCP_HTTP_BODY_LIMIT=20971520
# Upload JSON arguments <= min(upload limit, HTTP body limit - 65536).
# Pagination is separate: kDrive limit 1..200, default 50; not env-configurable.

# kChat is visible/callable only when BOTH variables are configured.
# KCHAT_HOST=your-team.kchat.infomaniak.com
# KCHAT_TOKEN=

# Entry points after npm run build:
# stdio 2026: npm start
# HTTP 2026: node build/main/http.js
# stdio 2025: node build/main/legacy.js
# HTTP 2025 (+2026): node build/main/legacy.js --http
# No MCP_TRANSPORT / MCP_STATELESS / session settings / calendar-disable switch.
MCP_HOST=127.0.0.1
MCP_PORT=3000
# PORT is only a fallback when MCP_PORT is unset.
# HTTP bearer token, >=16 characters; empty means absent.
MCP_HTTP_AUTH_TOKEN=
MCP_HTTP_ALLOW_UNAUTHENTICATED=false
# Unauthenticated mode is explicitly opt-in and loopback-only.
MCP_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
# Optional comma-separated origins; leave unset for the default empty list.
# MCP_CORS_ORIGINS=https://app.example.test
